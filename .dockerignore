# Build context for src/GameShelf.Api/Dockerfile and tests/Dockerfile is the repo root.
# Host build output must never enter the image build: obj/project.assets.json contains host paths.
**/bin/
**/obj/
**/node_modules/
**/dist/
**/coverage/
**/test-results/
**/playwright-report/
.git/
.github/
infra/
# The committed API contract: the backend test image diffs the live document against it, the
# frontend test image regenerates types and MSW coverage from it.
!infra/openapi.json
scripts/
docs/
*.md
.env
.env.*
!.env.example
