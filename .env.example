# Copy to .env to override docker-compose defaults. Local development only. .env is git-ignored.
MSSQL_SA_PASSWORD=GameShelf_Dev_Pa55word!

# --- Sign-in (optional) -------------------------------------------------------
# Leave these alone for local mode: no sign-in, every caller is a local Curator.
# To use the real identity provider with `npm run dev`, set all of them:
#   AUTH_ENABLED=true
#   OKTA_ISSUER=https://<your-org>.okta.com/oauth2/default
#   OKTA_CLIENT_ID=<client id of your Single-Page App>
#   BOOTSTRAP_CURATOR=<the email you sign in with>   # first sign-in creates this account as Curator
# The issuer and client id are public identifiers (PKCE flow) — not secrets.
AUTH_ENABLED=false
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_AUDIENCE=api://default
BOOTSTRAP_CURATOR=
