# syntax=docker/dockerfile:1
#
# Playwright runner for docker-compose.test.yml.
# The image tag MUST match the @playwright/test version pinned in package.json: the browsers baked
# into the image are built for that exact version, and a mismatch fails at launch.

FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /app
ENV CI=true

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY playwright.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY e2e ./e2e
COPY e2e-entrypoint.sh /usr/local/bin/e2e-entrypoint
RUN chmod +x /usr/local/bin/e2e-entrypoint

# The entrypoint waits for API_READY_URL and E2E_BASE_URL, then runs the command.
ENTRYPOINT ["e2e-entrypoint"]
CMD ["npx", "playwright", "test"]
